{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node", // Cambiado de 'bundler' a 'node' para mayor compatibilidad
    "allowJs": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "baseUrl": ".", 
    "types": ["vitest/globals", "@testing-library/jest-dom"],
    "paths": {
      "@/*": ["./resources/js/*"]
    },
    "jsx": "react-jsx"
  },
  "include": [
    "resources/js/**/*.ts",
    "resources/js/**/*.tsx",
    "vite.config.ts"
  ]
}